<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- 로그 저장 경로: 환경변수 LOG_PATH 없으면 /home/ubuntu/logs 사용 -->
  <springProperty name="LOG_PATH" source="logging.file.path" defaultValue="/home/ubuntu/logs"/>
  <springProperty name="APP_NAME" source="spring.application.name" defaultValue="dogcatsquare"/>

  <!-- 콘솔 출력 (journald가 수집) -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- 전체 로그 파일 (일별 롤링, 30일 보관) -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/${APP_NAME}.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- 에러 전용 파일 (서버 크래시 원인 분석용) -->
  <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/${APP_NAME}-error.log</file>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>ERROR</level>
    </filter>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/${APP_NAME}-error.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
      <totalSizeCap>500MB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- 운영 환경: 파일 + 콘솔 -->
  <springProfile name="!local">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="FILE"/>
      <appender-ref ref="ERROR_FILE"/>
    </root>

    <!-- 외부 API 호출 타임아웃/에러 추적 -->
    <logger name="DC_square.spring.service.place.GooglePlacesService" level="WARN"/>
    <logger name="DC_square.spring.service.WeatherService" level="WARN"/>

    <!-- SSE 연결 상태 추적 -->
    <logger name="DC_square.spring.service.notification.NotificationService" level="DEBUG"/>

    <!-- Hibernate SQL 로그 (운영에서는 비활성화) -->
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.type.descriptor.sql" level="WARN"/>
  </springProfile>

  <!-- 로컬 환경: 콘솔만 -->
  <springProfile name="local">
    <root level="DEBUG">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

</configuration>
